{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "./"
  },
  "exclude": [
    "dist",
    "node_modules"
  ],
  "include": [
    "**/*.ts"
  ]
}

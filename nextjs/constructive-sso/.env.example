# constructive-sso — cloud-function SSO (compute sync gateway)
#
# Copy this file to .env and fill in your values. .env is gitignored and must
# NEVER be committed — it holds your real OAuth client secret.
#
# Architecture: `fun up --k8s --alt-ports` (in the constructive-db repo)
# brings up ONE platform database — constructive-functions-db1, port-forwarded
# to :15432. The tenant is provisioned INSIDE it (pnpm create-db). There is no
# second database and no cnc GraphQL server.

# -----------------------------------------------------------------------------
# Platform database (the k8s platform DB from `fun up --k8s --alt-ports`)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=15432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=constructive-functions-db1

# -----------------------------------------------------------------------------
# Tenant provisioning (read by packages/provision/src/provision-tenant.ts)
# -----------------------------------------------------------------------------
# The tenant's name and the host its routes bind on.
DATABASE_NAME=myapp
SSO_ROUTE_HOST=localhost

# Populated by `pnpm create-db` — do not set manually (DATABASE_ID plus the
# NEXT_PUBLIC_* / GRAPHQL_* values below, derived from the tenant's
# platform-assigned host slug, e.g. 208-dry-rose-fox).
DATABASE_ID=

# -----------------------------------------------------------------------------
# GraphQL lanes (orgs, users, settings) — written by create-db
# -----------------------------------------------------------------------------
# The platform names the tenant's hosts from its internal slug, e.g.
# api-208-dry-rose-fox.localhost. The SDK's per-context endpoints point at the
# SAME-ORIGIN BFF proxy (/api/graphql/*): the SSO session cookie is host-only
# on `localhost` and never reaches the *-<slug>.localhost hosts directly, so
# the proxy forwards it server-side as a Bearer credential.
NEXT_PUBLIC_DB_NAME=<tenant-slug>
NEXT_PUBLIC_API_PORT=80
NEXT_PUBLIC_ADMIN_ENDPOINT=/api/graphql/admin
NEXT_PUBLIC_AUTH_ENDPOINT=/api/graphql/auth
NEXT_PUBLIC_APP_ENDPOINT=/api/graphql/app
# The proxy's upstreams (server-side only):
GRAPHQL_ADMIN_URL=http://admin-<tenant-slug>.localhost/graphql
GRAPHQL_AUTH_URL=http://auth-<tenant-slug>.localhost/graphql
GRAPHQL_APP_URL=http://api-<tenant-slug>.localhost/graphql

# -----------------------------------------------------------------------------
# Cloud-function SSO lane (read by configure-sso.ts + the Next.js BFF)
# -----------------------------------------------------------------------------
# The compute sync gateway (Traefik -> compute-sync on port 80). Server-side
# only (Next.js route handlers: relay, session BFF).
SSO_GATEWAY_URL=http://localhost
# Same value, NEXT_PUBLIC_ so the CLIENT auth blocks can inline it at build
# time (they navigate the browser to /auth/start). Without the NEXT_PUBLIC_
# prefix the client bundle silently falls back to http://localhost.
NEXT_PUBLIC_SSO_GATEWAY_URL=http://localhost

# This app's own origin — where the provider's redirect lands. Must be plain
# http://localhost:3000 for the provider's plain-HTTP redirect rule. Written
# into the site's canonical_url; mantra composes the callback from it.
APP_ORIGIN=http://localhost:3000

# Identity provider credentials (read by configure-sso.ts at provision time —
# they are written into the tenant's provider row + encrypted secret store).
# Register this EXACT redirect URI in the Google Cloud Console OAuth client:
#   http://localhost:3000/auth/callback
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
# The issuer recorded on the provider row. Defaults to Google; point it at a
# local OIDC emulator (e.g. http://localhost:4010) to exercise the flow
# without Google — the endpoint knobs below carry the emulator's URLs.
OAUTH_ISSUER_URL=https://accounts.google.com
OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_SCOPES=openid,email,profile

# -----------------------------------------------------------------------------
# App UI (Next.js)
# -----------------------------------------------------------------------------
# Optional: override the dev server port (default: 3000)
# NEXT_PUBLIC_API_PORT is used by the GraphQL endpoint derivation above and is
# written by create-db; the dev server port itself is set via PORT (see
# package.json, default 3000).
